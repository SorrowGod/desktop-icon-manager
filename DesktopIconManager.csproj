<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets\app-icon.ico</ApplicationIcon>
    <Version>1.1.5</Version>
    <AssemblyVersion>1.1.5.0</AssemblyVersion>
    <FileVersion>1.1.5.0</FileVersion>
    <InformationalVersion>1.1.5</InformationalVersion>
    <Authors>Desktop Icon Manager</Authors>
    <Product>桌面管理器</Product>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove=".build*/**;build*/**;publish*/**;dist/**" />
    <EmbeddedResource Remove=".build*/**;build*/**;publish*/**;dist/**" />
    <None Remove=".build*/**;build*/**;publish*/**;dist/**" />
    <Content Remove=".build*/**;build*/**;publish*/**;dist/**" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="使用说明.md" CopyToPublishDirectory="Always" />
    <Content Include="README.md" CopyToPublishDirectory="Always" />
    <Content Include="CHANGELOG.md" CopyToPublishDirectory="Always" />
    <Content Include="PRIVACY.md" CopyToPublishDirectory="Always" />
    <Content Include="UNINSTALL.md" CopyToPublishDirectory="Always" />
    <Content Include="update-manifest.example.json" CopyToPublishDirectory="Always" />
  </ItemGroup>

</Project>
